<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- AGGIUNTO SOLO QUESTO PER VEDERE GLI ERRORI IN CHIARO -->
  <system.web>
      <customErrors mode="Off" />
	  <!-- maxRequestLength è in KB -->
    <httpRuntime 
        targetFramework="4.8"
        maxRequestLength="153600"
        executionTimeout="3600" />
  </system.web>

  <system.webServer>
    <httpErrors existingResponse="PassThrough" />
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    
    <!-- IL CODICE DI CLAUDIO INTATTO -->
    <handlers>
      <remove name="WebDAV" />
      <add name="ashx-handler"
           path="*.ashx"
           verb="*"
           type="System.Web.UI.SimpleHandlerFactory"
           resourceType="Unspecified" />
    </handlers>
	<security>
      <requestFiltering>
       <!-- 100MB = 104857600  Bytes -->
        <requestLimits maxAllowedContentLength="157286400"/>
      </requestFiltering>
    </security>

    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".mdx" />
      <mimeMap fileExtension=".mdx" mimeType="text/markdown" />
      <remove fileExtension=".md" />
      <mimeMap fileExtension=".md" mimeType="text/markdown" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <rewrite>
      <rules>
        <!-- Sicurezza: nega l'accesso diretto ai file sensibili (token di sessione, hash password) -->
        <rule name="Block sensitive data" stopProcessing="true">
          <match url="^Data/(tokens|users)\.json$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>

        <rule name="Ignore API calls" stopProcessing="true">
          <match url="^api/.*" ignoreCase="true" />
          <action type="None" />
        </rule>
        
        <rule name="Angular Routes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>